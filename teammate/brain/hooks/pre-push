#!/bin/sh
# Teammate brain (TM-03b): the bot may push only to its own branch.
# Installed read-only (/opt/teammate/brain/hooks, owned by root) and wired with
# core.hooksPath; the brain's permission rules deny git config, -c and --no-verify.
#   mercon repo -> ilan     mesiri repo -> main
repo=$(basename "$(git rev-parse --show-toplevel)")
case "$repo" in
  mercon) allowed="refs/heads/ilan" ;;
  mesiri) allowed="refs/heads/main" ;;
  *) echo "teammate: pushes from $repo aren't allowed" >&2; exit 1 ;;
esac
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" != "$allowed" ]; then
    echo "teammate: refusing to push to $remote_ref; only $allowed is allowed from $repo" >&2
    exit 1
  fi
done
exit 0
