# Mesiri.ai — environment template (M1 infrastructure).
#
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit a real `.env`. No real secrets belong in this file.
#
# Nested settings use `__` as the delimiter, e.g. MESIRI_POSTGRES__HOST.
# Required-in-production keys have NO safe default and fail fast when missing.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
MESIRI_ENVIRONMENT=local          # local | test | staging | production
MESIRI_SERVICE_NAME=mesiri-assistant
MESIRI_LOG__LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
MESIRI_LOG__FORMAT=json          # json | console

# ---------------------------------------------------------------------------
# PostgreSQL (matches docker-compose service `postgres`)
# ---------------------------------------------------------------------------
MESIRI_POSTGRES__HOST=localhost
MESIRI_POSTGRES__PORT=5432
MESIRI_POSTGRES__USER=mesiri
MESIRI_POSTGRES__PASSWORD=mesiri_local_dev
MESIRI_POSTGRES__DATABASE=mesiri
MESIRI_POSTGRES__POOL_MIN_SIZE=5   # keep 5 connections warm; eliminates cold-start stalls
MESIRI_POSTGRES__POOL_MAX_SIZE=20  # enough for 4 uvicorn workers × 5 concurrent queries
MESIRI_POSTGRES__CONNECT_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Redis (matches docker-compose service `redis`)
# ---------------------------------------------------------------------------
MESIRI_REDIS__HOST=localhost
MESIRI_REDIS__PORT=6379
MESIRI_REDIS__DB=0
MESIRI_REDIS__PASSWORD=
MESIRI_REDIS__NAMESPACE=mesiri
MESIRI_REDIS__CONNECT_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Object storage (Cloudflare R2 — S3-compatible). Uses the fake adapter locally
# unless MESIRI_OBJECT_STORAGE__PROVIDER=r2.
# ---------------------------------------------------------------------------
MESIRI_OBJECT_STORAGE__PROVIDER=fake      # fake | r2 | local (production: local, decided 13 Oct)
MESIRI_OBJECT_STORAGE__BUCKET=mesiri-media-local
MESIRI_OBJECT_STORAGE__ENDPOINT_URL=      # https://<account>.r2.cloudflarestorage.com
MESIRI_OBJECT_STORAGE__ACCESS_KEY_ID=
MESIRI_OBJECT_STORAGE__SECRET_ACCESS_KEY=
MESIRI_OBJECT_STORAGE__REGION=auto
MESIRI_OBJECT_STORAGE__PRESIGN_TTL_SECONDS=900
# provider=local: files on this server's disk, served by the app's /media route
# through signed links. Generate the secret with: openssl rand -hex 32
MESIRI_OBJECT_STORAGE__LOCAL_ROOT=/var/lib/mesiri/media
MESIRI_OBJECT_STORAGE__PUBLIC_BASE_URL=   # https://mesiri.mercon.tech
MESIRI_OBJECT_STORAGE__SIGNING_SECRET=

# Signs dashboard logins. Must be set in production; the code's fallback is public.
# Generate with: openssl rand -hex 32
MESIRI_JWT_SECRET=

# ---------------------------------------------------------------------------
# AI providers (M3). Absent in normal/CI tests — fakes are used.
# ---------------------------------------------------------------------------
MESIRI_SARVAM__API_KEY=
MESIRI_SARVAM__TIMEOUT_SECONDS=7
MESIRI_SARVAM__MAX_RETRIES=1      # 1 retry is enough; 2 retries = up to 21s wasted on transient STT failure
MESIRI_GEMINI__API_KEY=
MESIRI_GEMINI__MODEL=gemini-2.5-flash
MESIRI_GEMINI__TIMEOUT_SECONDS=15
MESIRI_GEMINI__MAX_RETRIES=1      # 1 retry is enough; 2 retries = up to 45s wasted per call on transient failure

# ---------------------------------------------------------------------------
# WhatsApp (owned by M2 / Alan — declared here for completeness, unused by M1/M3)
# ---------------------------------------------------------------------------
MESIRI_WHATSAPP__VERIFY_TOKEN=
MESIRI_WHATSAPP__APP_SECRET=
MESIRI_WHATSAPP__ACCESS_TOKEN=
MESIRI_WHATSAPP__PHONE_NUMBER_ID=
# WA-02: seconds of quiet (after the last forwarded message finishes) before a
# forwarded batch gets its one summary reply. 0 turns batching off.
MESIRI_FORWARD_BATCH_SECONDS=10
