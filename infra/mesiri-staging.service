[Unit]
Description=Mesiri.AI STAGING (FastAPI / uvicorn, 127.0.0.1 only; sends no WhatsApp) (INF-02)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mesiri-staging/apps/whatsapp-assistant/src
Environment=PYTHONPATH=/opt/mesiri-staging/shared/contracts/src:/opt/mesiri-staging/platform/ai/src:/opt/mesiri-staging/backend/src:/opt/mesiri-staging/apps/whatsapp-assistant/src
EnvironmentFile=/opt/mesiri-staging/.env
ExecStart=/opt/mesiri-staging/.venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port ${MESIRI_APP_PORT} \
    --workers 1 \
    --log-level info
Restart=on-failure
RestartSec=5s
MemoryMax=1G
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mesiri-staging

[Install]
WantedBy=multi-user.target
